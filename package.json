{
  "name": "@stonefish-labs/agent-riskmap",
  "version": "0.0.1",
  "description": "Point it at an agent surface (skills, MCP servers, hooks, prompts, extensions); it profiles each along eight risk dimensions, composes the agent-native hazards, and says what to restrict / prune / gate. Includes live introspection of remote/opaque MCP servers you have no source for.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ledger": {
      "types": "./dist/ledger.d.ts",
      "import": "./dist/ledger.js"
    },
    "./triage": {
      "types": "./dist/triage.d.ts",
      "import": "./dist/triage.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-riskmap": "./dist/cli.js",
    "riskmap": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "extensions"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": [
    "agent",
    "security",
    "risk",
    "capability",
    "exfiltration",
    "mcp",
    "skills",
    "hooks",
    "prompt-injection",
    "supply-chain",
    "static-analysis"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0"
  },
  "license": "Apache-2.0",
  "author": "batteryshark",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batteryshark/agent-riskmap.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
