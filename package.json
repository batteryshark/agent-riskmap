{
  "name": "@stonefish-labs/agent-riskmap",
  "version": "0.0.1",
  "description": "Point it at an agent surface (skills, MCP servers, hooks, prompts, extensions); it maps which capability combinations could lead to exfil or other hazards (EXFIL/RCE/DROP), the overall posture, and what to restrict / prune / gate behind HITL.",
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "agent-riskmap": "./dist/cli.js", "riskmap": "./dist/cli.js" },
  "files": ["dist", "data"],
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "parity": "node --import tsx scripts/parity.ts"
  },
  "keywords": [
    "agent",
    "security",
    "risk",
    "capability",
    "exfiltration",
    "mcp",
    "skills",
    "hooks",
    "prompt-injection",
    "supply-chain",
    "static-analysis"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0"
  },
  "license": "Apache-2.0",
  "author": "batteryshark",
  "repository": { "type": "git", "url": "git+https://github.com/batteryshark/agent-riskmap.git" },
  "publishConfig": { "access": "public" }
}
